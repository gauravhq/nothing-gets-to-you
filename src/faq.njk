---
layout: base.njk
permalink: /faq/
title: FAQ
pageDescription: Answers to common questions about overreacting, staying calm under pressure, and the book Nothing Gets to You.
---
{#- Both the accordion below and this FAQPage block are generated from src/_data/faqs.js,
    so a question can never exist in one and not the other. -#}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faqs.all %}{"@type":"Question","name":{{ item.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<section class="section"><div class="wrap" style="max-width:820px">
  <div class="eyebrow" style="color:var(--red-dark);font-weight:800;letter-spacing:1px;text-transform:uppercase">FAQ</div>
  <h1>Questions people ask</h1>
  <p class="lead">Short, honest answers drawn from <em>Nothing Gets to You</em> and from well-established research on stress, anger, and emotion. Tap a question to open it.</p>
  <nav aria-label="Jump to a topic" style="margin:18px 0 6px;display:flex;flex-wrap:wrap;gap:8px">
    {%- for g in faqs.groups %}
    <a href="#{{ g.id }}" style="background:var(--paper);border-radius:999px;padding:6px 14px;font-size:14px;font-weight:700;text-decoration:none;box-shadow:0 4px 12px rgba(0,0,0,.07)">{{ g.category }}</a>
    {%- endfor %}
  </nav>
  {%- for g in faqs.groups %}
  <h2 id="{{ g.id }}" style="text-transform:none;color:var(--red-dark);margin-top:34px;scroll-margin-top:78px">{{ g.category }}</h2>
  {%- for item in g.items %}
  <details class="faq">
    <summary>{{ item.q }}</summary>
    <div class="faq-a"><p>{{ item.a }}</p>
      {%- if item.link %}
      <p class="faq-more"><a href="{{ item.link }}">{{ item.linkText or "Read the full idea" }}</a></p>
      {%- endif %}
    </div>
  </details>
  {%- endfor %}
  {%- endfor %}
  <div class="buybar">
    <p><strong>Ready to read it?</strong> <em>Nothing Gets to You</em> by Gaurav Srivastava.</p>
    <div class="btn-row"><a class="btn" href="{{ site.amazon.kindle }}" target="_blank" rel="noopener">Get it on Kindle</a>
    <a class="btn ghost" href="/book/">About the book</a></div>
  </div>
</div></section>
